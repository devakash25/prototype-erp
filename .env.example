# ============================================
# Render Backend — set in Render Dashboard
# ============================================

# DATABASE_URL — from Supabase (Settings → Database → Connection string → URI)
DATABASE_URL=postgresql://postgres.YOUR_REF:YOUR_PASS@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres

# REDIS_URL — from Upstash (Console → Database → Connect → Redis URL)
REDIS_URL=rediss://YOUR_UPSTASH_URL

# JWT — auto-generated by Render, or set manually
JWT_SECRET=generate_with_openssl_rand_hex_32
JWT_REFRESH_SECRET=generate_with_openssl_rand_hex_32

JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PORT=5000
NODE_ENV=production

# Your Vercel frontend URL
APP_URL=https://your-app.vercel.app
