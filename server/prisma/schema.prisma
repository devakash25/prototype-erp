// ============================================
// TRANSPORT
// ============================================

model Vehicle {
  id              String   @id @default(uuid())
  institutionId   String
  registrationNumber String
  type            String   // bus, van, car
  capacity        Int
  model           String?
  manufacturer    String?
  year            Int?
  insuranceExpiry DateTime?
  fitnessExpiry   DateTime?
  permitExpiry    DateTime?
  pollutionExpiry DateTime?
  roadTaxExpiry   DateTime?
  rcExpiry        DateTime?
  color           String?
  fuelType        String?  // diesel, petrol, cng, electric
  mileage         Int?
  lastServiceDate DateTime?
  nextServiceDate DateTime?
  assignedDriverId String?
  status          String   @default("ACTIVE") // ACTIVE, INACTIVE, MAINTENANCE
  isActive        Boolean  @default(true)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  institution     Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  driver          Employee?    @relation(fields: [assignedDriverId], references: [id], onDelete: SetNull)
  routes          VehicleRoute[]
  inspections     VehicleInspection[]
  maintenances    VehicleMaintenance[]

  @@unique([institutionId, registrationNumber])
  @@map("vehicles")
}

model Route {
  id              String   @id @default(uuid())
  institutionId   String
  name            String
  code            String
  description     String?
  managerId       String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  institution     Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  manager         Employee?       @relation(fields: [managerId], references: [id], onDelete: SetNull)
  stops           RouteStop[]
  vehicles        VehicleRoute[]
  students        Student[]

  @@map("routes")
}

model RouteStop {
  id              String   @id @default(uuid())
  routeId         String
  name            String
  address         String?
  latitude        Decimal? @db.Decimal(10, 8)
  longitude       Decimal? @db.Decimal(11, 8)
  sequence        Int
  estimatedTime   Int?     // minutes from start
  createdAt       DateTime @default(now())

  route           Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@map("route_stops")
}

model VehicleRoute {
  id              String   @id @default(uuid())
  vehicleId       String
  routeId         String
  shift           String   // morning, afternoon, evening
  departureTime   DateTime?
  arrivalTime     DateTime?

  vehicle         Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  route           Route   @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@map("vehicle_routes")
}

model VehicleInspection {
  id              String   @id @default(uuid())
  vehicleId       String
  inspectedById   String?
  inspectionDate  DateTime @default(now())
  inspectionType  String   // daily, weekly, monthly
  status          String   @default("PASS") // PASS, FAIL
  checklist       Json?
  notes           String?
  nextInspection  DateTime?
  createdAt       DateTime @default(now())

  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@map("vehicle_inspections")
}

model VehicleMaintenance {
  id              String   @id @default(uuid())
  vehicleId       String
  type            String   // SERVICE, REPAIR, INSPECTION, OIL_CHANGE, TIRE_CHANGE, BRAKE_INSPECTION
  title           String
  description     String?
  scheduledDate   DateTime?
  completedDate   DateTime?
  cost            Decimal? @db.Decimal(10, 2)
  status          String   @default("SCHEDULED") // SCHEDULED, IN_PROGRESS, COMPLETED, CANCELLED
  mechanic        String?
  workshop        String?
  odometer        Int?
  nextServiceDate DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@map("vehicle_maintenances")
}

model DriverAttendance {
  id              String   @id @default(uuid())
  institutionId   String
  driverId        String
  date            DateTime @default(now())
  status          String   // PRESENT, ABSENT, LEAVE, REPLACEMENT
  replacementDriverId String?
  routeId         String?
  notes           String?
  createdAt       DateTime @default(now())

  @@map("driver_attendance")
}

// ============================================
// NOTIFICATIONS & ANNOUNCEMENTS
// ============================================

model Notification {
  id              String   @id @default(uuid())
  institutionId   String
  senderId        String?
  title           String
  message         String
  type            NotificationType
  target          NotificationTarget
  priority        NotificationPriority @default(NORMAL)
  isScheduled     Boolean  @default(false)
  scheduledAt     DateTime?
  isSent          Boolean  @default(false)
  sentAt          DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  institution     Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  sender          User?            @relation("NotificationSender", fields: [senderId], references: [id], onDelete: SetNull)
  recipients      UserNotification[]

  @@map("notifications")
}

model UserNotification {
  id              String   @id @default(uuid())
  notificationId  String
  userId          String
  studentId       String?
  isRead          Boolean  @default(false)
  readAt          DateTime?
  createdAt       DateTime @default(now())

  notification    Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  student         Student?     @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@unique([notificationId, userId])
  @@index([userId, isRead])
  @@map("user_notifications")
}

model Announcement {
  id              String   @id @default(uuid())
  institutionId   String
  authorId        String
  title           String
  content         String
  type            AnnouncementType
  target          NotificationTarget
  priority        NotificationPriority @default(NORMAL)
  isPublished     Boolean  @default(false)
  publishedAt     DateTime?
  expiresAt       DateTime?
  attachments     Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  institution     Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  author          User        @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@map("announcements")
}

enum NotificationType {
  INFO
  WARNING
  URGENT
  SUCCESS
  ERROR
}

enum NotificationTarget {
  ALL
  STUDENTS
  EMPLOYEES
  TEACHERS
  PARENTS
  DEPARTMENT
  SPECIFIC_USERS
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum AnnouncementType {
  GENERAL
  ACADEMIC
  EVENT
  HOLIDAY
  MEETING
  EMERGENCY
  POLICY
}

