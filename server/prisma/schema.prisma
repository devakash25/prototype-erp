// ============================================
// DEV ERP - Complete Database Schema
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// INSTITUTION & ACADEMIC SESSION
// ============================================

model Institution {
  id            String   @id @default(uuid())
  name          String
  code          String   @unique
  type          InstitutionType @default(COLLEGE) // SCHOOL or COLLEGE
  address       String?
  city          String?
  state         String?
  country       String?  @default("India")
  pincode       String?
  phone         String?
  email         String?
  website       String?
  logo          String?
  establishedAt DateTime?
  timezone      String   @default("Asia/Kolkata")
  currency      String   @default("INR")
  academicYearStart Int  @default(4) // month (1-12)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users          User[]
  departments    Department[]
  academicSessions AcademicSession[]
  courses        Course[]
  subjects       Subject[]
  feeStructures  FeeStructure[]
  buildings      Building[]
  vehicles       Vehicle[]
  routes         Route[]
  hostels        Hostel[]
  libraryBooks   LibraryBook[]
  notifications  Notification[]
  announcements  Announcement[]
  calendarEvents CalendarEvent[]
  workflows      Workflow[]
  documents      Document[]
  helpdeskTickets HelpdeskTicket[]
  certificates    Certificate[]
  studentRequests StudentRequest[]
  meetings        Meeting[]
  settings       InstitutionSetting[]
  auditLogs      AuditLog[]
  employees      Employee[]
  parents        Parent[]
  students       Student[]
  admissions     Admission[]
  timetables     Timetable[]
  examinations   Examination[]
  scholarships   Scholarship[]
  subscriptions  InstitutionSubscription[]
  invoices       Invoice[]
  doubtConversations DoubtConversation[]
  parentConversations ParentConversation[]
  mcqTests       McqTest[]

  @@map("institutions")
}

model AcademicSession {
  id              String   @id @default(uuid())
  institutionId   String
  name            String   // "2024-2025"
  startDate       DateTime
  endDate         DateTime
  isActive        Boolean  @default(false)
  isCurrent       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  institution     Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  students        Student[]
  employees       Employee[]
  admissions      Admission[]
  timetables      Timetable[]
  examinations    Examination[]
  feeStructures   FeeStructure[]
  attendance      Attendance[]
  academicCalendar AcademicCalendar[]
  subjectAllocations SubjectAllocation[]

  @@unique([institutionId, name])
  @@map("academic_sessions")
}

model InstitutionSetting {
  id            String   @id @default(uuid())
  institutionId String
  key           String
  value         Json
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([institutionId, key])
  @@map("institution_settings")
}

// ============================================
// USER MANAGEMENT & RBAC
// ============================================

model User {
  id              String    @id @default(uuid())
  institutionId   String?
  email           String    @unique
  password        String
  role            UserRole
  employeeId      String?
  studentId       String?
  parentId        String?
  firstName       String
  lastName        String
  fullName        String
  phone           String?
  secondaryPhone  String?
  avatar          String?
  dateOfBirth     DateTime?
  gender          Gender?
  bloodGroup      String?
  address         String?
  city            String?
  state           String?
  country         String?   @default("India")
  pincode         String?
  isActive        Boolean   @default(true)
  isEmailVerified Boolean   @default(false)
  isPhoneVerified Boolean   @default(false)
  lastLoginAt     DateTime?
  loginCount      Int       @default(0)
  passwordChangedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  institution     Institution? @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  employee        Employee?
  student         Student?
  parent          Parent?
  refreshTokens   RefreshToken[]
  activityLogs    ActivityLog[]
  sentNotifications Notification[]       @relation("NotificationSender")
  userNotifications UserNotification[]
  uploadedDocuments Document[]           @relation("DocumentUploader")
  createdWorkflows  Workflow[]           @relation("WorkflowCreator")
  workflowActions   WorkflowAction[]
  helpdeskTickets   HelpdeskTicket[]     @relation("TicketCreator")
  helpdeskAssignments HelpdeskTicket[]   @relation("TicketAssignee")
  helpdeskComments  HelpdeskComment[]
  auditLogs         AuditLog[]
  calendarEvents    CalendarEvent[]      @relation("EventCreator")
  announcements     Announcement[]       @relation("AnnouncementAuthor")
  doubtMessages     DoubtMessage[]
  parentMessages    ParentMessage[]

  @@index([institutionId])
  @@index([role])
  @@map("users")
}

enum UserRole {
  CEO
  CHIEF_HEAD
  PRINCIPAL
  VICE_PRINCIPAL
  TEACHER
  ACCOUNTANT
  ADMISSION_COUNSELLOR
  RECEPTIONIST
  EXAM_CONTROLLER
  LIBRARIAN
  HOSTEL_WARDEN
  TRANSPORT_MANAGER
  ADMINISTRATIVE_STAFF
  STUDENT
  PARENT
}

enum InstitutionType {
  SCHOOL
  COLLEGE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model ActivityLog {
  id          String   @id @default(uuid())
  userId      String
  action      String
  entity      String?
  entityId    String?
  details     Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([entity, entityId])
  @@map("activity_logs")
}

// ============================================
// DEPARTMENTS & COURSES
// ============================================

model Department {
  id              String   @id @default(uuid())
  institutionId   String
  name            String
  code            String
  description     String?
  headId          String?
  phone           String?
  email           String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  institution     Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  hod             Employee?     @relation("DepartmentHOD", fields: [headId], references: [id])
  courses         Course[]
  subjects        Subject[]
  employees       Employee[]       @relation("DepartmentEmployees")
  students        Student[]
  feeStructures   FeeStructure[]
  timetables      Timetable[]
  examinations    Examination[]
  admissions      Admission[]

  @@unique([institutionId, code])
  @@map("departments")
}

model Course {
  id              String   @id @default(uuid())
  institutionId   String
  departmentId    String
  name            String
  code            String
  description     String?
  duration        Int      // in months
  totalSemesters  Int?
  type            String   // regular, diploma, certificate
  level           String   // undergraduate, postgraduate, doctoral, secondary, higher_secondary
  maxStudents     Int?
  fees            Decimal? @db.Decimal(12, 2)
  classCoordinatorId String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  institution     Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  department      Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  coordinator     Employee?    @relation("CourseCoordinator", fields: [classCoordinatorId], references: [id], onDelete: SetNull)
  subjects        Subject[]
  students        Student[]
  feeStructures   FeeStructure[]
  timetableEntries TimetableEntry[]
  admissions      Admission[]
  attendanceModes AttendanceMode[]
  dailyAttendance DailyAttendance[]
  subjectAttendance SubjectAttendance[]
   doubtConversations DoubtConversation[]
   mcqTests         McqTest[]

   @@unique([institutionId, code])
   @@map("courses")
}

// ============================================
// SUBJECTS
// ============================================

model Subject {
  id              String   @id @default(uuid())
  institutionId   String
  departmentId    String
  courseId         String?
  name            String
  code            String
  description     String?
  credits         Int      @default(0)
  type            String   // theory, practical, elective
  totalMarks      Int      @default(100)
  passingMarks    Int      @default(33)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  institution     Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  department      Department    @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  course          Course?       @relation(fields: [courseId], references: [id], onDelete: SetNull)
  timetableEntries TimetableEntry[]
  examSubjects    ExamSubject[]
  examResults     ExamResult[]
  assignments     Assignment[]
  studyMaterials  StudyMaterial[]
  subjectAllocations SubjectAllocation[]
  attendance      Attendance[]
  subjectAttendance SubjectAttendance[]
   doubtConversations DoubtConversation[]
   mcqTests         McqTest[]

   @@unique([institutionId, code])
   @@map("subjects")
}

model SubjectAllocation {
  id              String   @id @default(uuid())
  subjectId       String
  employeeId      String
  academicSessionId String
  semester        Int?
  assignedAt      DateTime @default(now())

  subject         Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)

  @@unique([subjectId, employeeId, academicSessionId])
  @@map("subject_allocations")
}

// ============================================
// EMPLOYEES (Staff)
// ============================================

model Employee {
  id              String   @id @default(uuid())
  institutionId   String
  departmentId    String
  userId          String   @unique
  employeeCode    String
  designation     String
  department      EmployeeDepartment
  qualification   String?
  experience      Int?     // years
  dateOfJoining   DateTime
  dateOfLeaving   DateTime?
  employmentType  String   @default("full_time") // full_time, part_time, contract
  salary          Decimal? @db.Decimal(12, 2)
  bankAccountNo   String?
  ifscCode        String?
  panNumber       String?
  aadharNumber    String?
  emergencyContact String?
  emergencyPhone  String?
  documents       Json?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  institution     Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  departmentRel   Department    @relation("DepartmentEmployees", fields: [departmentId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  managedDepartments Department[] @relation("DepartmentHOD")
  subjectAllocations SubjectAllocation[]
  courses         Course[]    @relation("CourseCoordinator")
  timetables      TimetableEntry[]
  leaves          Leave[]
  attendances     EmployeeAttendance[]
  performanceReviews PerformanceReview[]
  assignedHostels Hostel[]
  assignedVehicles Vehicle[]
  assignedRoutes  Route[]
  academicSessions AcademicSession[]
  libraryIssues   LibraryIssue[]
  enabledAttendModes AttendanceMode[] @relation("AttendanceModeEnabledBy")
  lockedAttendModes AttendanceMode[] @relation("AttendanceModeLockedBy")
   dailyAttendances DailyAttendance[] @relation("DailyAttendanceMarker")
   subjectAttendances SubjectAttendance[] @relation("SubjectAttendanceTeacher")
   doubtConversations DoubtConversation[]
   parentConversations ParentConversation[]
   mcqTests         McqTest[]


  @@unique([institutionId, employeeCode])
  @@map("employees")
}

enum EmployeeDepartment {
  ACADEMIC
  ADMINISTRATION
  FINANCE
  LIBRARY
  HOSTEL
  TRANSPORT
  MAINTENANCE
  IT
  HR
}

// ============================================
// PARENTS
// ============================================

model Parent {
  id              String   @id @default(uuid())
  institutionId   String
  userId          String   @unique
  occupation      String?
  relationship    String   // father, mother, guardian
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  institution     Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  children        Student[]
  parentStudents  ParentStudent[]
  parentConversations ParentConversation[]

  @@map("parents")
}

model ParentStudent {
  id        String   @id @default(uuid())
  parentId  String
  studentId String
  createdAt DateTime @default(now())

  parent   Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student  Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@map("parent_students")
}

// ============================================
// STUDENTS
// ============================================

model Student {
  id                  String   @id @default(uuid())
  institutionId       String
  userId              String   @unique
  departmentId        String
  courseId             String
  academicSessionId   String
  admissionNumber     String
  rollNumber          String?
  enrollmentDate      DateTime @default(now())
  admissionType       String   // regular, lateral, transfer
  category            String?  // general, obc, sc, st, ews
  nationality         String?  @default("Indian")
  religion            String?
  caste               String?
  aadharNumber        String?
  previousSchool      String?
  previousPercentage  Decimal? @db.Decimal(5, 2)
  guardianName        String?
  guardianPhone       String?
  guardianRelation    String?
  parentId            String?
  hostelId            String?
  transportRouteId    String?
  isHostelStudent     Boolean  @default(false)
  usesTransport       Boolean  @default(false)
  isActive            Boolean  @default(true)
  documents           Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  institution         Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  department          Department       @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  course              Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  academicSession     AcademicSession  @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  parent              Parent?          @relation(fields: [parentId], references: [id], onDelete: SetNull)
  hostel              Hostel?          @relation(fields: [hostelId], references: [id], onDelete: SetNull)
  transportRoute      Route?           @relation(fields: [transportRouteId], references: [id], onDelete: SetNull)
  attendance          Attendance[]
  dailyAttendance DailyAttendance[]
  subjectAttendance SubjectAttendance[]
  examResults         ExamResult[]
  feePayments         FeePayment[]
  scholarships        StudentScholarship[]
  libraryIssues       LibraryIssue[]
  complaints          Complaint[]
  notifications       UserNotification[]
  admission           Admission?
  submissions         AssignmentSubmission[]
  certificates        Certificate[]
  studentRequests     StudentRequest[]
  parentStudents      ParentStudent[]
   parentConversations ParentConversation[]
    mcqSubmissions   McqSubmission[]
    hostelAllocations HostelRoomAllocation[]

    @@unique([institutionId, admissionNumber])
   @@index([institutionId, isActive])
   @@map("students")
}

// ============================================
// ADMISSIONS
// ============================================

model Admission {
  id              String   @id @default(uuid())
  institutionId   String
  studentId       String?  @unique
  academicSessionId String
  applicationNumber String
  firstName       String
  lastName        String
  email           String
  phone           String
  dateOfBirth     DateTime
  gender          Gender
  departmentId    String?
  courseId         String?
  previousSchool  String?
  previousPercentage Decimal? @db.Decimal(5, 2)
  documents       Json?
  status          AdmissionStatus @default(APPLIED)
  source          String?  @default("DIRECT") // DIRECT, ONLINE, PHONE, WALK_IN, REFERRAL
  priority        String?  @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  parentName      String?
  parentPhone     String?
  parentEmail     String?
  parentRelation  String?
  address         String?
  city            String?
  state           String?
  pincode         String?
  category        String?  // GENERAL, SC, ST, OBC, EWS, OTHER
  bloodGroup      String?
  medicalInfo     String?
  emergencyContact String?
  emergencyPhone  String?
  counselorNotes  String?
  followUpDate    DateTime?
  lastFollowUp    DateTime?
  appliedAt       DateTime @default(now())
  reviewedAt      DateTime?
  reviewedBy      String?
  approvedAt      DateTime?
  approvedBy      String?
  rejectedAt      DateTime?
  rejectedBy      String?
  rejectionReason String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  institution     Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  student         Student?       @relation(fields: [studentId], references: [id], onDelete: SetNull)
  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  department      Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  course          Course?        @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@unique([institutionId, applicationNumber])
  @@map("admissions")
}

enum AdmissionStatus {
  APPLIED
  UNDER_REVIEW
  APPROVED
  REJECTED
  ENROLLED
  CANCELLED
}

// ============================================
// TIMETABLE
// ============================================

model Timetable {
  id              String   @id @default(uuid())
  institutionId   String
  departmentId    String
  academicSessionId String
  name            String
  dayOfWeek       Int      // 0-6 (Sunday-Saturday)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  institution     Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  department      Department       @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  academicSession AcademicSession  @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  entries         TimetableEntry[]

  @@map("timetables")
}

model TimetableEntry {
  id              String   @id @default(uuid())
  timetableId     String
  subjectId       String
  employeeId      String
  courseId         String
  startTime       DateTime
  endTime         DateTime
  room            String?
  type            String   @default("lecture") // lecture, lab, tutorial
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  timetable       Timetable  @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  subject         Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  employee        Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  course          Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  subjectAttendance SubjectAttendance[]

  @@map("timetable_entries")
}

// ============================================
// ATTENDANCE
// ============================================

model Attendance {
  id              String   @id @default(uuid())
  studentId       String
  subjectId       String
  academicSessionId String
  date            DateTime @db.Date
  status          AttendanceStatus
  markedBy        String?
  remarks         String?
  createdAt       DateTime @default(now())

  student         Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject         Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId, date])
  @@index([studentId, date])
  @@map("attendance")
}

model EmployeeAttendance {
  id              String   @id @default(uuid())
  employeeId      String
  date            DateTime @db.Date
  checkIn         DateTime?
  checkOut        DateTime?
  status          AttendanceStatus
  overtime        Int?     // minutes
  remarks         String?
  createdAt       DateTime @default(now())

  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@map("employee_attendance")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  HALF_DAY
  ON_LEAVE
}

// ============================================
// DUAL ATTENDANCE SYSTEM
// ============================================

enum AttendanceModeType {
  COORDINATOR
  SUBJECT
}

enum AttendanceSession {
  MORNING
  EVENING
}

model AttendanceMode {
  id              String   @id @default(uuid())
  classId         String
  date            DateTime @db.Date
  mode            AttendanceModeType
  enabledBy       String
  locked          Boolean  @default(false)
  lockedAt        DateTime?
  lockedBy        String?
  createdAt       DateTime @default(now())

  class           Course   @relation(fields: [classId], references: [id], onDelete: Cascade)
  enabler         Employee @relation("AttendanceModeEnabledBy", fields: [enabledBy], references: [id], onDelete: Cascade)
  locker          Employee? @relation("AttendanceModeLockedBy", fields: [lockedBy], references: [id], onDelete: SetNull)

  dailyAttendance DailyAttendance[]
  subjectAttendance SubjectAttendance[]

  @@unique([classId, date])
  @@map("attendance_modes")
}

model DailyAttendance {
  id              String   @id @default(uuid())
  studentId       String
  classId         String
  attendanceModeId String
  date            DateTime @db.Date
  session         AttendanceSession
  status          AttendanceStatus
  markedBy        String
  remarks         String?
  createdAt       DateTime @default(now())

  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class           Course   @relation(fields: [classId], references: [id], onDelete: Cascade)
  attendanceMode  AttendanceMode @relation(fields: [attendanceModeId], references: [id], onDelete: Cascade)
  marker          Employee @relation("DailyAttendanceMarker", fields: [markedBy], references: [id], onDelete: Cascade)

  @@unique([studentId, classId, date, session])
  @@map("daily_attendance")
}

model SubjectAttendance {
  id              String   @id @default(uuid())
  studentId       String
  classId         String
  subjectId       String
  timetableEntryId String
  teacherId       String
  attendanceModeId String
  date            DateTime @db.Date
  status          AttendanceStatus
  markedAt        DateTime @default(now())

  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class           Course   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject         Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  timetableEntry  TimetableEntry @relation(fields: [timetableEntryId], references: [id], onDelete: Cascade)
  teacher         Employee @relation("SubjectAttendanceTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  attendanceMode  AttendanceMode @relation(fields: [attendanceModeId], references: [id], onDelete: Cascade)

  @@unique([studentId, classId, subjectId, date])
  @@map("subject_attendance")
}

// ============================================
// EXAMINATIONS & RESULTS
// ============================================

model Examination {
  id              String   @id @default(uuid())
  institutionId   String
  departmentId    String
  academicSessionId String
  name            String
  type            ExamType
  startDate       DateTime
  endDate         DateTime
  resultDate      DateTime?
  maxMarks        Int      @default(100)
  passingMarks    Int      @default(33)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  institution     Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  department      Department       @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  academicSession AcademicSession  @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  subjects        ExamSubject[]
  results         ExamResult[]

  @@map("examinations")
}

model ExamSubject {
  id              String   @id @default(uuid())
  examinationId   String
  subjectId       String
  examDate        DateTime
  maxMarks        Int
  passingMarks    Int
  startTime       DateTime?
  endTime         DateTime?
  room            String?

  examination     Examination @relation(fields: [examinationId], references: [id], onDelete: Cascade)
  subject         Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@map("exam_subjects")
}

model ExamResult {
  id              String   @id @default(uuid())
  examinationId   String
  studentId       String
  subjectId       String
  marksObtained   Decimal? @db.Decimal(5, 2)
  grade           String?
  gradePoints     Decimal? @db.Decimal(3, 1)
  isPassed        Boolean  @default(false)
  remarks         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  examination     Examination @relation(fields: [examinationId], references: [id], onDelete: Cascade)
