// ============================================
// FEE MANAGEMENT
// ============================================

model FeeStructure {
  id              String   @id @default(uuid())
  institutionId   String
  departmentId    String?
  courseId         String?
  academicSessionId String
  name            String
  description     String?
  totalAmount     Decimal  @db.Decimal(12, 2)
  dueDate         DateTime?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  institution     Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  department      Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  course          Course?          @relation(fields: [courseId], references: [id], onDelete: SetNull)
  academicSession AcademicSession  @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  components      FeeComponent[]
  payments        FeePayment[]

  @@index([institutionId, isActive])
  @@map("fee_structures")
}

model FeeComponent {
  id              String   @id @default(uuid())
  feeStructureId  String
  name            String
  amount          Decimal  @db.Decimal(12, 2)
  type            String   // tuition, admission, hostel, transport, exam, library, misc
  isRefundable    Boolean  @default(false)
  createdAt       DateTime @default(now())

  feeStructure    FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)

  @@map("fee_components")
}

model FeePayment {
  id              String   @id @default(uuid())
  studentId       String
  feeStructureId  String
  amount          Decimal  @db.Decimal(12, 2)
  paidAmount      Decimal  @db.Decimal(12, 2) @default(0)
  dueAmount       Decimal  @db.Decimal(12, 2)
  status          PaymentStatus @default(PENDING)
  paymentMethod   PaymentMethod?
  transactionId   String?
  receiptNumber   String?
  paidAt          DateTime?
  dueDate         DateTime?
  lateFee         Decimal? @db.Decimal(12, 2) @default(0)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  student         Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructure    FeeStructure  @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  refunds         Refund[]

  @@index([studentId, status])
  @@index([paidAt])
  @@map("fee_payments")
}

model Refund {
  id              String   @id @default(uuid())
  paymentId       String
  amount          Decimal  @db.Decimal(12, 2)
  reason          String
  status          String   @default("pending") // pending, approved, rejected
  approvedBy      String?
  processedAt     DateTime?
  createdAt       DateTime @default(now())

  payment         FeePayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("refunds")
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  NET_BANKING
  CHEQUE
  DEMAND_DRAFT
  ONLINE
}

model Scholarship {
  id              String   @id @default(uuid())
  institutionId   String
  name            String
  description     String?
  amount          Decimal  @db.Decimal(12, 2)
  percentage      Decimal? @db.Decimal(5, 2)
  criteria        Json?
  maxRecipients   Int?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  institution     Institution        @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  recipients      StudentScholarship[]

  @@map("scholarships")
}

model StudentScholarship {
  id              String   @id @default(uuid())
  studentId       String
  scholarshipId   String
  amount          Decimal  @db.Decimal(12, 2)
  academicYear    String
  status          String   @default("active") // active, completed, revoked
  awardedAt       DateTime @default(now())
  createdAt       DateTime @default(now())

  student         Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  scholarship     Scholarship @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)

  @@map("student_scholarships")
}

