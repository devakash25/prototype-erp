// ============================================
// DOUBT SOLVING SYSTEM
// ============================================

enum DoubtStatus {
  NEW
  SEEN
  REPLIED
  RESOLVED
}

enum MessageSenderRole {
  STUDENT
  TEACHER
}

enum AttachmentType {
  IMAGE
  PDF
}

model DoubtConversation {
  id              String   @id @default(uuid())
  institutionId   String
  classId         String
  subjectId       String
  teacherId       String
  status          DoubtStatus @default(NEW)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  institution     Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  course          Course      @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject         Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher         Employee    @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  messages        DoubtMessage[]

  @@unique([teacherId, subjectId, classId])
  @@map("doubt_conversations")
}

model DoubtMessage {
  id              String   @id @default(uuid())
  conversationId  String
  senderId        String
  senderRole      MessageSenderRole
  message         String
  attachmentUrl   String?
  attachmentType  AttachmentType?
  read            Boolean  @default(false)
  createdAt       DateTime @default(now())

  conversation    DoubtConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          User              @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@map("doubt_messages")
}

// ============================================
// CALENDAR
// ============================================

model CalendarEvent {
  id              String   @id @default(uuid())
  institutionId   String
  creatorId       String
  title           String
  description     String?
  startDate       DateTime
  endDate         DateTime
  allDay          Boolean  @default(false)
  location        String?
  type            String   // event, holiday, exam, meeting, deadline
  recurrence      String?  // daily, weekly, monthly, yearly
  color           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  institution     Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  creator         User            @relation("EventCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  @@map("calendar_events")
}

model AcademicCalendar {
  id              String   @id @default(uuid())
  academicSessionId String
  name            String
  description     String?
  startDate       DateTime
  endDate         DateTime
  type            String   // semester, holiday, exam, result, admission
  createdAt       DateTime @default(now())

  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)

  @@map("academic_calendar")
}

// ============================================
// AUDIT LOG
// ============================================

model AuditLog {
  id              String   @id @default(uuid())
  institutionId   String
  userId          String
  action          String
  entity          String
  entityId        String?
  oldValues       Json?
  newValues       Json?
  ip              String?
  userAgent       String?
  createdAt       DateTime @default(now())

  institution     Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([institutionId, createdAt])
  @@index([userId])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// ============================================
// LEAVE MANAGEMENT
// ============================================

model Leave {
  id              String   @id @default(uuid())
  employeeId      String
  type            String   // casual, sick, earned, maternity, paternity, unpaid
  startDate       DateTime
  endDate         DateTime
  totalDays       Int
  reason          String
  status          String   @default("pending") // pending, approved, rejected
  approvedBy      String?
  approvedAt      DateTime?
  comments        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("leaves")
}

// ============================================
// PERFORMANCE
// ============================================

model PerformanceReview {
  id              String   @id @default(uuid())
  employeeId      String
  reviewerId      String
  academicSessionId String?
  period          String   // "2024-2025"
  rating          Int      // 1-5
  strengths       String?
  improvements    String?
  comments        String?
  createdAt       DateTime @default(now())

  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("performance_reviews")
}

// ============================================
// PLATFORM / SaaS SUBSCRIPTION MANAGEMENT
// ============================================

model SubscriptionPlan {
  id              String   @id @default(uuid())
  name            String   // Basic, Pro, Custom
  code            String   @unique
  description     String?
  planType        String   @default("custom") // basic, pro, custom
  monthlyPrice    Decimal  @db.Decimal(12, 2) @default(0)
  annualPrice     Decimal  @db.Decimal(12, 2) @default(0)
  userLimit       Int      @default(100)
  storageLimitGB  Int      @default(10) // in GB
  modules         Json     // ["dashboard", "attendance", "fees", "library", ...] - feature IDs
  features        Json?    // additional metadata
  isActive        Boolean  @default(true)
  isDefault       Boolean  @default(false) // true for Basic/Pro preset plans
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subscriptions   InstitutionSubscription[]
  rolePricing     RolePricing[]
  charges         Charge[]

  @@map("subscription_plans")
}

model RolePricing {
  id           String   @id @default(uuid())
  planId       String
  role         String   // UserRole enum value: STUDENT, TEACHER, etc.
  pricePerSeat Decimal  @db.Decimal(10, 2) // price per user of this role per month
  isEnabled    Boolean  @default(true) // whether this role is included in the plan
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  plan         SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, role])
  @@map("role_pricing")
}

model InstitutionSubscription {
  id              String   @id @default(uuid())
  institutionId   String
  planId          String
  billingCycle    String   @default("monthly") // monthly, yearly
  startDate       DateTime
  endDate         DateTime
  autoRenew       Boolean  @default(true)
  status          String   @default("active") // active, suspended, cancelled, expired, trial
  trialEndsAt     DateTime?
  userCount       Int      @default(0)
  storageUsedGB   Decimal  @db.Decimal(10, 2) @default(0)
  amount          Decimal  @db.Decimal(12, 2)
  discount        Decimal  @db.Decimal(12, 2) @default(0)
  tax             Decimal  @db.Decimal(12, 2) @default(0)
  totalAmount     Decimal  @db.Decimal(12, 2)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  institution     Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  plan            SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  invoices        Invoice[]

  @@unique([institutionId, planId])
  @@map("institution_subscriptions")
}

model Invoice {
  id              String   @id @default(uuid())
  institutionId   String
  subscriptionId  String
  invoiceNumber   String   @unique
  amount          Decimal  @db.Decimal(12, 2)
  tax             Decimal  @db.Decimal(12, 2) @default(0)
  discount        Decimal  @db.Decimal(12, 2) @default(0)
  totalAmount     Decimal  @db.Decimal(12, 2)
  status          String   @default("pending") // pending, paid, overdue, cancelled
  dueDate         DateTime
  paidAt          DateTime?
  notes           String?
  items           Json     // line items
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  institution     Institution       @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  subscription    InstitutionSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  payments        Payment[]

  @@map("invoices")
}

model Payment {
  id              String   @id @default(uuid())
  invoiceId       String
  amount          Decimal  @db.Decimal(12, 2)
  method          String   // ONLINE, CASH, CARD, UPI, NET_BANKING, CHEQUE
  transactionId   String?
  receiptNumber   String?
  status          String   @default("completed") // completed, pending, failed, refunded
  paidAt          DateTime @default(now())
  notes           String?
  createdAt       DateTime @default(now())

  invoice         Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model PlatformAuditLog {
  id              String   @id @default(uuid())
  userId          String?
  institutionId   String?
  action          String   // institution.created, institution.suspended, subscription.upgraded, invoice.generated, payment.received, user.deactivated, etc.
  entity          String   // institution, subscription, invoice, payment, user
  entityId        String?
  details         Json?
  ip              String?
  userAgent       String?
  createdAt       DateTime @default(now())

  @@index([institutionId, createdAt])
  @@index([action])
  @@map("platform_audit_logs")
}

model PlatformNotification {
  id              String   @id @default(uuid())
  title           String
  message         String
  type            String   // INFO, WARNING, URGENT, SUCCESS
  category        String   // subscription, payment, institution, platform, security
  targetRole      String   @default("CHIEF_HEAD") // CHIEF_HEAD, ALL
  institutionId   String?
  isRead          Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@map("platform_notifications")
}

model Charge {
  id              String   @id @default(uuid())
  planId          String?
  title           String
  description     String?
  amount          Decimal  @db.Decimal(12, 2)
  type            String   @default("subscription") // subscription, addon, penalty, discount, custom
  status          String   @default("unpaid") // paid, unpaid, overdue, cancelled
  billingPeriod   String?  // monthly, quarterly, annual, one-time
  dueDate         DateTime?
  paidAt          DateTime?
  paidAmount      Decimal? @db.Decimal(12, 2)
  paymentMethod   String?  // online, cash, card, upi, net_banking, cheque
  transactionId   String?
  receiptNumber   String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  plan            SubscriptionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@map("charges")
}

// ============================================
// PARENT-TEACHER MESSAGING
// ============================================

enum ParentMessageSenderRole {
  PARENT
  TEACHER
}

enum ParentRecipientType {
  SUBJECT_TEACHER
  CLASS_COORDINATOR
}

model ParentConversation {
  id              String   @id @default(uuid())
  institutionId   String
  parentId        String
  studentId       String
  teacherId       String
  recipientType   ParentRecipientType
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  institution     Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  parent          Parent           @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student         Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher         Employee         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  messages        ParentMessage[]

  @@unique([parentId, teacherId, studentId])
  @@map("parent_conversations")
}

model ParentMessage {
  id              String   @id @default(uuid())
  conversationId  String
  senderId        String
  senderRole      ParentMessageSenderRole
  message         String
  attachmentUrl   String?
  attachmentType  AttachmentType?
  isRead          Boolean  @default(false)
  createdAt       DateTime @default(now())

  conversation    ParentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          User               @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@map("parent_messages")
}

// ============================================
// MCQ ASSESSMENT MODULE
// ============================================

enum MCQTestStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model McqTest {
  id              String      @id @default(uuid())
  institutionId   String
  classId         String
  subjectId       String
  teacherId       String
  title           String
  chapter         String?
  instructions    String?
  duration        Int
  totalQuestions  Int         @default(0)
  totalMarks      Int         @default(0)
  startTime       DateTime
  endTime         DateTime
  status          MCQTestStatus @default(DRAFT)
  allowReattempt  Boolean     @default(false)
  randomizeQuestions Boolean  @default(false)
  randomizeOptions   Boolean  @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  institution     Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  course          Course      @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject         Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher         Employee    @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  questions       McqQuestion[]
  submissions     McqSubmission[]

  @@map("mcq_tests")
}

model McqQuestion {
  id              String   @id @default(uuid())
  testId          String
  question        String
  optionA         String
  optionB         String
  optionC         String
  optionD         String
  correctAnswer   String
  marks           Int      @default(1)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())

  test            McqTest        @relation(fields: [testId], references: [id], onDelete: Cascade)
  answers         McqAnswer[]

  @@map("mcq_questions")
}

model McqSubmission {
  id              String   @id @default(uuid())
  testId          String
  studentId       String
  score           Int      @default(0)
  total           Int      @default(0)
  percentage      Float    @default(0)
  timeTaken       Int?
  submittedAt     DateTime @default(now())

  test            McqTest   @relation(fields: [testId], references: [id], onDelete: Cascade)
  student         Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers         McqAnswer[]

  @@unique([testId, studentId])
  @@map("mcq_submissions")
}

model McqAnswer {
  id              String   @id @default(uuid())
  submissionId    String
  questionId      String
  selectedOption  String
  isCorrect       Boolean  @default(false)
  marks           Int      @default(0)

  submission      McqSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question        McqQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("mcq_answers")
}
